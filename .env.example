# Postgres connection string (any Postgres works — Supabase, Neon, local, …)
# For Supabase use the pooled connection string (port 6543) in serverless environments.
DATABASE_URL=postgresql://postgres:password@localhost:5432/toodoo

# Secret used by Better Auth to sign sessions. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL of the app (optional on Vercel — VERCEL_URL is used automatically)
BETTER_AUTH_URL=http://localhost:3000

# Resend API key for transactional email (password reset, email verification,
# project invites). Emails are skipped (logged) when unset. https://resend.com/api-keys
RESEND_API_KEY=

# From address for outgoing email (must be a verified domain on Resend).
EMAIL_FROM=toodoo <onboarding@resend.dev>

# ——— Google sign-in (optional) ———
# Create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add
#   <BETTER_AUTH_URL>/api/auth/callback/google
# as an authorized redirect URI. Leave unset to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ——— Domain locking (optional, for company deployments) ———
# Comma-separated list of email domains allowed to create accounts, enforced
# server-side for both email/password and Google sign-ups.
# Example: AUTH_ALLOWED_EMAIL_DOMAINS=acme.com,acme.dev
AUTH_ALLOWED_EMAIL_DOMAINS=

# Stricter Google Workspace lock: only accounts from this hosted domain can
# sign in with Google (verified against the Google id token, not just a UI
# hint). Use "*" to allow any Workspace account but no personal Gmail.
GOOGLE_HOSTED_DOMAIN=

# ——— Desktop app (optional) ———
# GitHub repository (owner/repo) whose releases the /desktop install page
# links to. Leave unset to offer the upstream builds, which connect to any
# toodoo server. Forks that ship their own desktop build set their repo.
DESKTOP_RELEASES_REPO=
